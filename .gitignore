# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# 测试与本地构建产物
.pytest_cache/
.mypy_cache/

# 运行期数据（默认在 %LOCALAPPDATA%，此处防止误提交）
data/
logs/
*.db

# 每日扫描报告：本地留档，不进仓库（否则一年会堆 300+ 个文件）
reports/

# 调研原始材料：第三方规范/文档抓取，本地参考用，不入库
mcp-research/

# 插件打包产物：构建输出，不入库（`xbc plugin build` 默认写到 dist/）
dist/
*.xbcplugin
